{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Pytest",
      "type": "shell",
      "command": "pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Start Dev Server",
      "type": "shell",
      "command": "uvicorn src.api.app:app --reload --port 8000",
      "group": "build"
    }
  ]
}
